{
  "info": {
    "name": "bulgumtong API",
    "description": "스터디 출결 및 벌금 관리 API\n\n더미 데이터 멤버 ID:\n- m-001 김민준 (스터디장)\n- m-002 이수연 (일반 멤버)\n- m-003 박준혁 (일반 멤버)\n- m-004 정유나 (일반 멤버)\n- m-005 최성현 (일반 멤버)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "leaderId",
      "value": "m-001",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "m-003",
      "type": "string"
    },
    {
      "key": "today",
      "value": "2026-05-22",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Members (멤버)",
      "item": [
        {
          "name": "전체 멤버 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"]
            },
            "description": "권한 없이 전체 멤버 목록을 조회합니다."
          }
        },
        {
          "name": "멤버 추가 (리더)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members?requesterId={{leaderId}}&name=홍길동&role=MEMBER",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"],
              "query": [
                { "key": "requesterId", "value": "{{leaderId}}", "description": "요청자 ID (스터디장만 가능)" },
                { "key": "name",        "value": "홍길동",        "description": "새 멤버 이름" },
                { "key": "role",        "value": "MEMBER",       "description": "LEADER 또는 MEMBER" }
              ]
            },
            "description": "스터디장(m-001)만 멤버를 추가할 수 있습니다."
          }
        },
        {
          "name": "멤버 추가 (일반 멤버 시도 → 403)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members?requesterId=m-002&name=홍길동&role=MEMBER",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"],
              "query": [
                { "key": "requesterId", "value": "m-002",  "description": "일반 멤버 → 403 예상" },
                { "key": "name",        "value": "홍길동" },
                { "key": "role",        "value": "MEMBER" }
              ]
            },
            "description": "일반 멤버가 추가 시도 → 403 UnauthorizedException 응답 예상"
          }
        }
      ]
    },
    {
      "name": "Attendance (출결)",
      "item": [
        {
          "name": "출결 조회 - 리더가 타인 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?requesterId={{leaderId}}&memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "requesterId", "value": "{{leaderId}}", "description": "리더 ID" },
                { "key": "memberId",    "value": "{{memberId}}", "description": "조회할 대상 멤버 ID" }
              ]
            },
            "description": "리더는 모든 멤버의 출결을 조회할 수 있습니다."
          }
        },
        {
          "name": "출결 조회 - 본인 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?requesterId=m-002&memberId=m-002",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "requesterId", "value": "m-002", "description": "본인 ID" },
                { "key": "memberId",    "value": "m-002", "description": "본인 ID와 동일" }
              ]
            },
            "description": "일반 멤버는 본인 기록만 조회할 수 있습니다."
          }
        },
        {
          "name": "출결 조회 - 타인 조회 시도 (→ 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?requesterId=m-002&memberId=m-003",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "requesterId", "value": "m-002", "description": "이수연 (일반 멤버)" },
                { "key": "memberId",    "value": "m-003", "description": "박준혁 (타인) → 403 예상" }
              ]
            },
            "description": "일반 멤버가 타인 기록 조회 시도 → 403 응답 예상"
          }
        },
        {
          "name": "출석 체크 - 리더가 멤버 출석 처리",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?requesterId={{leaderId}}&memberId={{memberId}}&date={{today}}&status=PRESENT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "requesterId", "value": "{{leaderId}}", "description": "요청자 (리더)" },
                { "key": "memberId",    "value": "{{memberId}}", "description": "대상 멤버 ID" },
                { "key": "date",        "value": "{{today}}",    "description": "세션 날짜 YYYY-MM-DD" },
                { "key": "status",      "value": "PRESENT",      "description": "PRESENT / ABSENT / LATE" }
              ]
            },
            "description": "리더가 박준혁(m-003)을 오늘 날짜 출석 처리합니다.\n세션 시작 후 10분 이내에만 PRESENT 처리 가능합니다."
          }
        },
        {
          "name": "지각 체크 - 본인이 직접",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?requesterId=m-002&memberId=m-002&date={{today}}&status=LATE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "requesterId", "value": "m-002",    "description": "이수연 본인" },
                { "key": "memberId",    "value": "m-002",    "description": "본인 ID" },
                { "key": "date",        "value": "{{today}}" },
                { "key": "status",      "value": "LATE",     "description": "지각 처리" }
              ]
            },
            "description": "일반 멤버가 본인을 지각 처리합니다."
          }
        },
        {
          "name": "결석 처리 - 리더가 강제 결석",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?requesterId={{leaderId}}&memberId=m-005&date={{today}}&status=ABSENT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "requesterId", "value": "{{leaderId}}", "description": "리더" },
                { "key": "memberId",    "value": "m-005",        "description": "최성현" },
                { "key": "date",        "value": "{{today}}" },
                { "key": "status",      "value": "ABSENT",       "description": "결석 처리" }
              ]
            },
            "description": "리더가 최성현(m-005)을 결석 처리합니다."
          }
        },
        {
          "name": "타인 출결 체크 시도 (→ 403)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?requesterId=m-002&memberId=m-003&date={{today}}&status=PRESENT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "requesterId", "value": "m-002",   "description": "이수연 (일반 멤버)" },
                { "key": "memberId",    "value": "m-003",   "description": "박준혁 (타인) → 403 예상" },
                { "key": "date",        "value": "{{today}}" },
                { "key": "status",      "value": "PRESENT" }
              ]
            },
            "description": "일반 멤버가 타인 출결 체크 시도 → 403 응답 예상"
          }
        }
      ]
    },
    {
      "name": "History (변경 이력)",
      "item": [
        {
          "name": "변경 이력 조회 - 리더",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history?requesterId={{leaderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"],
              "query": [
                { "key": "requesterId", "value": "{{leaderId}}", "description": "리더 ID" }
              ]
            },
            "description": "Command 패턴으로 누적된 출결 변경 이력을 조회합니다. 리더만 가능."
          }
        },
        {
          "name": "변경 이력 조회 - 일반 멤버 시도 (→ 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history?requesterId=m-002",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"],
              "query": [
                { "key": "requesterId", "value": "m-002", "description": "일반 멤버 → 403 예상" }
              ]
            },
            "description": "일반 멤버가 이력 조회 시도 → 403 응답 예상"
          }
        }
      ]
    },
    {
      "name": "Report (벌금 리포트)",
      "item": [
        {
          "name": "벌금 정산 리포트 - 리더",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/report?requesterId={{leaderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report"],
              "query": [
                { "key": "requesterId", "value": "{{leaderId}}", "description": "리더 ID" }
              ]
            },
            "description": "멤버별 결석/지각 횟수와 벌금 합계를 반환합니다. 리더만 가능.\n\nFactory 패턴으로 계산:\n- 결석 1회 = 5,000원\n- 지각 1회 = 2,000원"
          }
        },
        {
          "name": "벌금 정산 리포트 - 일반 멤버 시도 (→ 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/report?requesterId=m-002",
              "host": ["{{baseUrl}}"],
              "path": ["api", "report"],
              "query": [
                { "key": "requesterId", "value": "m-002", "description": "일반 멤버 → 403 예상" }
              ]
            },
            "description": "일반 멤버가 리포트 조회 시도 → 403 응답 예상"
          }
        }
      ]
    }
  ]
}
